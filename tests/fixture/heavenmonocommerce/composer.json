{
    "name": "prestashopheaven/heavenmonocommerce",
    "description": "Fixture module of mono-runtime-commerce: runs the integration tests of the commerce packages in real shops. Never released.",
    "type": "prestashop-module",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/*",
            "options": {
                "symlink": false,
                "versions": {
                    "prestashopheaven/runtime-voucher": "1.0.0",
                    "prestashopheaven/runtime-cart": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/runtime-cart": "1.0.0",
        "prestashopheaven/runtime-kit": "^1.0",
        "prestashopheaven/runtime-voucher": "1.0.0"
    },
    "require-dev": {
        "prestashopheaven/build-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PrestaShopHeaven\\MonoCommerce\\Fixture\\": "src/"
        },
        "classmap": [
            "heavenmonocommerce.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaShopHeaven\\MonoCommerce\\Fixture\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "prepend-autoloader": false
    },
    "extra": {
        "prestashopheaven": {
            "scope-prefix": "PrestaShopHeaven\\MonoCommerce\\Fixture\\Vendor"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "ps-module mono fixture-tests"
        ],
        "post-update-cmd": [
            "ps-module mono fixture-tests"
        ]
    }
}
